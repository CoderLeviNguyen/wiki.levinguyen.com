{
  "name": "verified-knowledge-wiki",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "validate": "tsx src/cli.ts lint",
    "lint": "tsc --noEmit && npm run validate",
    "dry-run": "tsx src/cli.ts ingest --input tests/fixtures/input.json --dry-run",
    "check": "npm run test && npm run lint && npm run dry-run"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
